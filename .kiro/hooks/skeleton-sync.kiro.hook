{
  "enabled": true,
  "name": "skeleton-sync",
  "description": "When a file in skeleton/src/components changes, list which apps use it and what needs updating.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["skeleton/src/components/**"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file in skeleton/src/components changed. Search the apps/ folder for apps that import the changed component or contain a copy of the file. List each affected app and, for each, what needs updating (for example 'copy the file', 'rename prop X to Y in Z.tsx', 'update the test'). If apps/ has no apps yet, reply 'skeleton-sync: no apps exist yet, nothing to update'. This is a report only: do not edit any file in apps/. Shared improvements go into skeleton/ first, and apps are updated by the developer afterwards."
  }
}
