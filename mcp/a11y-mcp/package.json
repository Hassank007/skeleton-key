{
  "name": "a11y-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that checks running web pages for accessibility problems (axe, keyboard walk, contrast, outline).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src tests --max-warnings 0",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
